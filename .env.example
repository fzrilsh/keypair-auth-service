# Non-production example configuration.
DATABASE_URL=postgres://user:password@localhost:5432/keypair?sslmode=disable
JWT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/jwt-signing-private.pem
JWT_SIGNING_KEY_ID=key-2026-09
ALLOWED_CLIENT_IDS=app-a,app-b
JWKS_CACHE_MAX_AGE=5m
# Optional rotation overlap:
# JWT_PREVIOUS_PUBLIC_KEY_FILE=/run/secrets/jwt-previous-public.pem
# JWT_PREVIOUS_KEY_ID=key-2026-08
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
HTTP_ADDR=:8080
JWT_ISSUER=keypair-auth-service
